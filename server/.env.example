# Neon connection string (Neon dashboard → Connection Details). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Long random string: openssl rand -hex 32
JWT_SECRET=change-me
# Optional: enables AI-generated detective cases. Without it, built-in cases are used.
ANTHROPIC_API_KEY=
# Optional model override for the detective game
CLAUDE_MODEL=claude-opus-5-5
# Max AI-generated detective cases per user per day (cost control)
DETECTIVE_DAILY_LIMIT=3
PORT=3001
